# Skopiuj do .env. Nie commituj prawdziwych kluczy.
ANTHROPIC_API_KEY=sk-ant-...
# claude | offline (domyślnie: claude, jeśli jest klucz)
ASSISTANT_MODE=claude
ASSISTANT_MODEL=claude-haiku-5-5
# Klucz do własnego API (nagłówek X-API-Key w module HTTP w Make)
ASSISTANT_API_KEY=wpisz-dlugi-losowy-ciag
